{
  "editor.copyWithSyntaxHighlighting": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.emptySelectionClipboard": false,
  "editor.stickyScroll.enabled": false,
  "workbench.editor.enablePreview": false,
  "window.newWindowDimensions": "inherit",
  "editor.multiCursorModifier": "ctrlCmd",
  "files.trimTrailingWhitespace": true,
  "diffEditor.renderSideBySide": false,
  "window.nativeFullScreen": true,
  "window.titleBarStyle": "custom",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "workbench.sideBar.location": "right",
  "workbench.editor.wrapTabs": false,
  "editor.minimap.enabled": false,
  "scm.diffDecorations": "all",
  "editor.matchBrackets": "always",
  "workbench.statusBar.visible": false,
  "workbench.tips.enabled": false,
  "editor.colorDecorators": false,
  "git.decorations.enabled": true,
  "workbench.startupEditor": "none",
  "editor.lightbulb.enabled": "off",
  "editor.selectionHighlight": false,
  "editor.overviewRulerBorder": false,
  "editor.renderLineHighlight": "none",
  "editor.occurrencesHighlight": "off",
  "problems.decorations.enabled": false,
  "editor.renderControlCharacters": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "workbench.colorTheme": "Catppuccin Macchiato",
  "workbench.iconTheme": "catppuccin-macchiato",
  "editor.fontFamily": "Dank Mono, Fira Code, Menlo, 'Courier New', monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
  "editor.fontSize": 16,
  "editor.fontWeight": "400",
  "editor.lineHeight": 0,
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontWeight": "400",
  "search.exclude": {
    "**/vendor/{[^l],?[^ai]}*": true,
    "**/tmp/*": true,
    "**/.cache/*": true,
    "**/public": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true,
    "**/_ide_helper.php": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "storage": true
  },
  "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": false,
  "editor.guides.indentation": false,
  "workbench.activityBar.location": "hidden",
  "editor.stickyTabStops": false,
  "editor.tabSize": 2,
  "java.editor.reloadChangedSources": "auto",
  "vim.foldfix": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "*.templ": "${capture}_templ.go,${capture}_templ.txt",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "typescript.tsserver.log": "off",
  "window.commandCenter": false,
  "debug.disassemblyView.showSourceCode": false,
  "editor.formatOnSave": true,
  "cursor.cpp.disabledLanguages": ["plaintext", "markdown", "scminput"],
  "search.useIgnoreFiles": false,
  "search.useGlobalIgnoreFiles": true,
  "git.blame.editorDecoration.enabled": false,
  "git.confirmSync": false,
  "go.toolsManagement.autoUpdate": true,
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "cursor.composer.queueMessageDefaultBehavior": "send",
  "git.openRepositoryInParentFolders": "never",
  "gitlens.currentLine.enabled": false,
  "git.blame.statusBarItem.enabled": false,
  "claudeCode.preferredLocation": "panel",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "accessibility.signalOptions.volume": 0,
  "accessibility.signals.terminalBell": {
    "sound": "off"
  },
  "terminal.integrated.enableVisualBell": false,
  "editor.accessibilitySupport": "off"
}
