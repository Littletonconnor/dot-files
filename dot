#!/usr/bin/env bash
#
# dot - Dotfiles management CLI
# Usage: dot <command> [options]
#

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

DOT_DIR="${DOT_DIR:-$HOME/.config/dot-files}"
HOME_DIR="$DOT_DIR/home"
PACKAGES_DIR="$DOT_DIR/packages"
BACKUP_DIR="$DOT_DIR/backups"

# Detect Homebrew path
if [[ -d "/opt/homebrew" ]]; then
  BREW_PREFIX="/opt/homebrew"
else
  BREW_PREFIX="/usr/local"
fi

# Special path mappings (source -> destination)
# Format: "relative/path/in/home:absolute/destination/path"
# If not listed, files copy directly to ~/ mirroring the home/ structure
declare -A PATH_MAPPINGS=(
  [".config/claude"]="$HOME/.claude"
)

print_help() {
  cat <<EOF
dot - Dotfiles management CLI

Usage: dot <command> [options]

Commands:
  init              Full system setup (interactive)
  sync              Copy dotfiles to home directory
  diff              Show differences between repo and installed files
  link              Install dot command globally
  unlink            Remove global dot command
  doctor            Check installation health
  backup            Create backup of current configs
  restore           Restore from backup

Package Management:
  package list [base|work]           List packages
  package add <name> [cask] [work]   Add package to bundle
  package remove <name> [bundle]     Remove package from bundle
  package update [name|all] [bundle] Update packages

Options:
  -h, --help        Show this help message
  -v, --version     Show version

Examples:
  dot init                           # Full setup
  dot sync                           # Copy dotfiles to home
  dot diff                           # See what would change
  dot package add neovim             # Add neovim formula
EOF
}

print_version() {
  echo "dot v2.0.0"
}

fancy_echo() {
  local message="$1"
  local color="${2:-NC}"
  case "$color" in
  red) echo -e "${RED}$message${NC}" ;;
  green) echo -e "${GREEN}$message${NC}" ;;
  yellow) echo -e "${YELLOW}$message${NC}" ;;
  blue) echo -e "${BLUE}$message${NC}" ;;
  *) echo "$message" ;;
  esac
}

check_command() {
  command -v "$1" &>/dev/null
}

ensure_homebrew() {
  if ! check_command brew; then
    fancy_echo "Installing Homebrew..." "blue"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$($BREW_PREFIX/bin/brew shellenv)"
  fi
}

# Get the destination path for a source file
get_dest_path() {
  local rel_path="$1"

  # Check if any mapping prefix matches
  for src_prefix in "${!PATH_MAPPINGS[@]}"; do
    if [[ "$rel_path" == "$src_prefix"* ]]; then
      local dest_prefix="${PATH_MAPPINGS[$src_prefix]}"
      local suffix="${rel_path#$src_prefix}"
      echo "${dest_prefix}${suffix}"
      return
    fi
  done

  # Default: copy to home directory
  echo "$HOME/$rel_path"
}

cmd_init() {
  fancy_echo "Starting dotfiles setup..." "blue"

  # Install Homebrew
  ensure_homebrew
  fancy_echo "✓ Homebrew installed" "green"

  # Install base packages
  fancy_echo "Installing base packages..." "blue"
  brew bundle --file="$PACKAGES_DIR/bundle" || true
  fancy_echo "✓ Base packages installed" "green"

  # Ask about work packages
  if [[ -f "$PACKAGES_DIR/bundle.work" ]]; then
    read -rp "Install work packages? (y/n) " -n 1
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      brew bundle --file="$PACKAGES_DIR/bundle.work" || true
      fancy_echo "✓ Work packages installed" "green"
    fi
  fi

  # Run sync
  cmd_sync

  fancy_echo "✓ Setup complete!" "green"
}

cmd_sync() {
  fancy_echo "Syncing dotfiles..." "blue"

  local copied=0
  local skipped=0

  # Find all files in home directory (excluding .git directories)
  while IFS= read -r -d '' src_file; do
    # Get relative path from home directory
    local rel_path="${src_file#$HOME_DIR/}"

    # Get destination path (handles special mappings)
    local dest_file
    dest_file=$(get_dest_path "$rel_path")

    # Create parent directory if needed
    local dest_dir
    dest_dir=$(dirname "$dest_file")
    mkdir -p "$dest_dir"

    # Copy the file
    cp "$src_file" "$dest_file"
    ((copied++))

  done < <(find "$HOME_DIR" -type f -not -path '*/.git/*' -print0)

  fancy_echo "✓ Synced $copied files" "green"

  # Show special mappings that were applied
  if [[ ${#PATH_MAPPINGS[@]} -gt 0 ]]; then
    fancy_echo "\nSpecial path mappings applied:" "blue"
    for src in "${!PATH_MAPPINGS[@]}"; do
      fancy_echo "  $src → ${PATH_MAPPINGS[$src]}" "yellow"
    done
  fi
}

cmd_diff() {
  fancy_echo "Checking for differences..." "blue"

  local has_diff=0

  while IFS= read -r -d '' src_file; do
    local rel_path="${src_file#$HOME_DIR/}"
    local dest_file
    dest_file=$(get_dest_path "$rel_path")

    if [[ ! -f "$dest_file" ]]; then
      fancy_echo "  NEW: $rel_path" "green"
      has_diff=1
    elif ! diff -q "$src_file" "$dest_file" &>/dev/null; then
      fancy_echo "  MODIFIED: $rel_path" "yellow"
      has_diff=1
    fi
  done < <(find "$HOME_DIR" -type f -not -path '*/.git/*' -print0)

  if [[ $has_diff -eq 0 ]]; then
    fancy_echo "✓ All files are in sync" "green"
  else
    echo
    fancy_echo "Run 'dot sync' to apply changes" "blue"
  fi
}

cmd_link() {
  local link_path="$BREW_PREFIX/bin/dot"

  if [[ -L "$link_path" ]]; then
    fancy_echo "dot is already linked at $link_path" "yellow"
    return 0
  fi

  sudo ln -sf "$DOT_DIR/dot" "$link_path"
  fancy_echo "✓ dot command linked to $link_path" "green"
}

cmd_unlink() {
  local link_path="$BREW_PREFIX/bin/dot"

  if [[ -L "$link_path" ]]; then
    sudo rm "$link_path"
    fancy_echo "✓ dot command unlinked" "green"
  else
    fancy_echo "dot is not linked" "yellow"
  fi
}

cmd_doctor() {
  fancy_echo "Running health checks..." "blue"

  local issues=0

  # Check Homebrew
  if check_command brew; then
    fancy_echo "✓ Homebrew installed" "green"
  else
    fancy_echo "✗ Homebrew not installed" "red"
    ((issues++))
  fi

  # Check key config files exist
  if [[ -f "$HOME/.zshrc" ]]; then
    fancy_echo "✓ .zshrc exists" "green"
  else
    fancy_echo "✗ .zshrc missing" "red"
    ((issues++))
  fi

  if [[ -d "$HOME/.config/zsh" ]]; then
    fancy_echo "✓ .config/zsh exists" "green"
  else
    fancy_echo "✗ .config/zsh missing" "red"
    ((issues++))
  fi

  if [[ -d "$HOME/.config/nvim" ]]; then
    fancy_echo "✓ .config/nvim exists" "green"
  else
    fancy_echo "✗ .config/nvim missing" "red"
    ((issues++))
  fi

  if [[ -f "$HOME/.claude/settings.json" ]]; then
    fancy_echo "✓ .claude/settings.json exists" "green"
  else
    fancy_echo "✗ .claude/settings.json missing" "red"
    ((issues++))
  fi

  # Check shell
  if [[ "$SHELL" == *"zsh"* ]]; then
    fancy_echo "✓ Zsh is default shell" "green"
  else
    fancy_echo "! Zsh is not default shell" "yellow"
  fi

  # Check for stale symlinks (from old stow setup)
  local stale_symlinks=0
  for item in "$HOME/.zshrc" "$HOME/.config/zsh" "$HOME/.config/nvim"; do
    if [[ -L "$item" ]]; then
      fancy_echo "! $item is a symlink (consider running 'dot sync' to convert to copy)" "yellow"
      ((stale_symlinks++))
    fi
  done

  if [[ $issues -eq 0 ]]; then
    fancy_echo "\n✓ All checks passed!" "green"
  else
    fancy_echo "\n$issues issue(s) found" "red"
  fi

  if [[ $stale_symlinks -gt 0 ]]; then
    fancy_echo "$stale_symlinks symlink(s) detected from old stow setup" "yellow"
  fi
}

cmd_backup() {
  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local backup_path="$BACKUP_DIR/$timestamp"

  mkdir -p "$backup_path"

  fancy_echo "Creating backup at $backup_path..." "blue"

  # Backup key configs
  cp -R "$HOME/.zshrc" "$backup_path/" 2>/dev/null || true
  cp -R "$HOME/.config/zsh" "$backup_path/zsh" 2>/dev/null || true
  cp -R "$HOME/.config/nvim" "$backup_path/nvim" 2>/dev/null || true
  cp -R "$HOME/.config/git" "$backup_path/git" 2>/dev/null || true
  cp -R "$HOME/.claude" "$backup_path/claude" 2>/dev/null || true

  # Compress
  cd "$BACKUP_DIR"
  tar -czf "$timestamp.tar.gz" "$timestamp"
  rm -rf "$backup_path"

  fancy_echo "✓ Backup created: $BACKUP_DIR/$timestamp.tar.gz" "green"
}

cmd_restore() {
  if [[ ! -d "$BACKUP_DIR" ]]; then
    fancy_echo "No backups found" "red"
    return 1
  fi

  fancy_echo "Available backups:" "blue"
  ls -1 "$BACKUP_DIR"/*.tar.gz 2>/dev/null || {
    fancy_echo "No backups found" "red"
    return 1
  }

  read -rp "Enter backup filename to restore: " backup_file

  if [[ -f "$BACKUP_DIR/$backup_file" ]]; then
    cd "$BACKUP_DIR"
    tar -xzf "$backup_file"
    local dir_name="${backup_file%.tar.gz}"

    fancy_echo "Restoring from $backup_file..." "blue"
    cp -R "$dir_name"/* "$HOME/.config/" 2>/dev/null || true
    rm -rf "$dir_name"

    fancy_echo "✓ Restore complete" "green"
  else
    fancy_echo "Backup not found: $backup_file" "red"
    return 1
  fi
}

cmd_package() {
  local action="${1:-}"
  shift || true

  case "$action" in
  list)
    local bundle="${1:-all}"
    if [[ "$bundle" == "all" || "$bundle" == "base" ]]; then
      fancy_echo "Base packages:" "blue"
      cat "$PACKAGES_DIR/bundle" | grep -E "^brew|^cask" || true
    fi
    if [[ "$bundle" == "all" || "$bundle" == "work" ]]; then
      fancy_echo "\nWork packages:" "blue"
      cat "$PACKAGES_DIR/bundle.work" | grep -E "^brew|^cask" || true
    fi
    ;;
  add)
    local name="${1:-}"
    local type="${2:-brew}"
    local bundle="${3:-base}"

    if [[ -z "$name" ]]; then
      fancy_echo "Usage: dot package add <name> [cask] [work]" "red"
      return 1
    fi

    local bundle_file="$PACKAGES_DIR/bundle"
    [[ "$bundle" == "work" ]] && bundle_file="$PACKAGES_DIR/bundle.work"

    if [[ "$type" == "cask" ]]; then
      echo "cask \"$name\"" >>"$bundle_file"
      brew install --cask "$name" || true
    else
      echo "brew \"$name\"" >>"$bundle_file"
      brew install "$name" || true
    fi

    # Sort the bundle file
    sort -o "$bundle_file" "$bundle_file"
    fancy_echo "✓ Added $name to $bundle bundle" "green"
    ;;
  remove)
    local name="${1:-}"
    local bundle="${2:-}"

    if [[ -z "$name" ]]; then
      fancy_echo "Usage: dot package remove <name> [bundle]" "red"
      return 1
    fi

    local removed=0
    for file in "$PACKAGES_DIR/bundle" "$PACKAGES_DIR/bundle.work"; do
      if [[ -f "$file" ]]; then
        if grep -q "\"$name\"" "$file"; then
          sed -i '' "/\"$name\"/d" "$file"
          ((removed++))
        fi
      fi
    done

    if [[ $removed -gt 0 ]]; then
      fancy_echo "✓ Removed $name from bundle(s)" "green"
      read -rp "Uninstall $name? (y/n) " -n 1
      echo
      if [[ $REPLY =~ ^[Yy]$ ]]; then
        brew uninstall "$name" 2>/dev/null || brew uninstall --cask "$name" 2>/dev/null || true
      fi
    else
      fancy_echo "Package $name not found in bundles" "yellow"
    fi
    ;;
  update)
    local target="${1:-all}"

    fancy_echo "Updating Homebrew..." "blue"
    brew update

    if [[ "$target" == "all" ]]; then
      brew upgrade
      brew upgrade --cask
    else
      brew upgrade "$target" 2>/dev/null || brew upgrade --cask "$target" 2>/dev/null || true
    fi

    fancy_echo "✓ Packages updated" "green"
    ;;
  *)
    fancy_echo "Unknown package command: $action" "red"
    fancy_echo "Available: list, add, remove, update" "yellow"
    return 1
    ;;
  esac
}

# Main
main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
  init) cmd_init ;;
  sync) cmd_sync ;;
  diff) cmd_diff ;;
  stow)
    fancy_echo "Note: 'stow' has been replaced with 'sync' (now uses copies instead of symlinks)" "yellow"
    cmd_sync
    ;;
  link) cmd_link ;;
  unlink) cmd_unlink ;;
  doctor) cmd_doctor ;;
  backup) cmd_backup ;;
  restore) cmd_restore ;;
  package) cmd_package "$@" ;;
  -h | --help | help) print_help ;;
  -v | --version) print_version ;;
  "") print_help ;;
  *)
    fancy_echo "Unknown command: $cmd" "red"
    print_help
    exit 1
    ;;
  esac
}

main "$@"
